<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <AdditionalFiles Include="Documentation/ContactPayload.xml" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EmitCompilerGeneratedFiles Condition="'$(GITHUB_RUN_ID)' != ''">true</EmitCompilerGeneratedFiles>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
    <SharedLibraryVersion Condition="'$(SharedLibraryVersion)' == ''">1.0.*-*</SharedLibraryVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(GITHUB_ACTIONS)' != 'true' Or '$(UseLocalMalievDependencies)' == 'true'">
    <ProjectReference Include="$(MalievWorkspaceRoot)\Legacy.Maliev.ServiceDefaults\src\Legacy.Maliev.ServiceDefaults\Legacy.Maliev.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true' And '$(UseLocalMalievDependencies)' != 'true'">
    <PackageReference Include="Legacy.Maliev.ServiceDefaults" Version="$(SharedLibraryVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Legacy.Maliev.ContactService.Application\Legacy.Maliev.ContactService.Application.csproj" />
    <ProjectReference Include="..\Legacy.Maliev.ContactService.Data\Legacy.Maliev.ContactService.Data.csproj" />
  </ItemGroup>

  <Target Name="PreserveHostedCompilerEvidence" AfterTargets="Build"
          Condition="'$(GITHUB_RUN_ID)' != '' And '$(Configuration)' == 'Release' And '$(VSTestResultsDirectory)' != ''">
    <ItemGroup>
      <OwnedCompilerEvidence Include="$(BaseIntermediateOutputPath)**/OpenApiXmlCommentSupport.generated.cs" />
      <OwnedCompilerEvidence Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(OwnedCompilerEvidence)"
          DestinationFolder="$(VSTestResultsDirectory)/compiler-evidence/$(MSBuildProjectName)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
